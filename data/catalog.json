    {
      "id": "liquidity",
      "label": "Liquidity",
      "role": "cause",
      "blurb": "Who is forced to buy or sell."
    },
    {
      "id": "transmission",
      "label": "Rates + dollar",
      "role": "transmission",
      "blurb": "Is that liquidity easy or tight in markets."
    },
    {
      "id": "labels",
      "label": "Growth + inflation",
      "role": "labels",
      "blurb": "What regime the real economy is in."
    },
    {
      "id": "risk",
      "label": "Risk",
      "role": "tape",
      "blurb": "What the market is already pricing."
    },
    {
      "id": "assets",
      "label": "Assets",
      "role": "outputs",
      "blurb": "Outputs — never lead with these."
    }
